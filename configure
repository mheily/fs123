#!/bin/bash

if ! [ -d legacy ] ; then
	git fetch origin master
	mkdir legacy
	git archive master | tar -C legacy/ -xf -
fi

if ! [ -e legacy/Dockerfile ] ; then
  # Use a hard link so it will be accessible inside the build context
  ln $(pwd)/Dockerfile.legacy legacy/Dockerfile
fi

if ! [[ -d .venv ]] ; then
	if [[ "$(uname)" == "Darwin" ]] ; then
		/opt/homebrew/bin/python3.12 -m venv .venv
		source .venv/bin/activate
		cd python ; pip3 install -e .[dev]
	fi
fi

# TODO: move elsewhere

